[run]
omit =
    tests/*
    venv/*
    venv_bot/*
    venv_new/*
    test_*.py
    __pycache__/*
    migrations/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    pass
    except ImportError:
